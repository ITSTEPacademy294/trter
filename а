result = []

def divider(a, b):
    if a < b:
        raise ValueError("a менше за b")
    if b > 100:
        raise IndexError("b більше за 100")
    return a / b

# Замінили [] на число, оскільки списки не можуть бути ключами словника в Python
data = {10: 2, 2: 5, "123": 4, 18: 0, 15: 15, 8: 4}

for key in data:
    try:
        # Виправлено помилку з 'kem' на 'key'
        res = divider(key, data[key])
        result.append(res)
    except Exception as e:
        # Виводимо тип винятку та повідомлення у консоль
        print(f"Помилка для key={key}, value={data[key]}: {type(e).__name__} - {e}")

print("Результат:", result)
